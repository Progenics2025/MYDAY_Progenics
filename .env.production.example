# MyDay HRMS - Production Environment Variables
# Copy this file to .env and fill in your values

# ================================
# Database (PostgreSQL)
# ================================
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db:5432/myday_db
DB_PASSWORD=YOUR_SECURE_PASSWORD

# ================================
# Security
# ================================
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-chars
SESSION_SECRET=your-session-secret-at-least-32-chars

# ================================
# Application
# ================================
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://myday.progenicslabs.com

# ================================
# Email (SMTP) - Optional
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
